# stateloom docker compose — copy to `.env` and edit.
#
#   cp .env.docker.example .env
#   docker compose up -d
#
# Nothing here is required: every value has a working default. The two most
# people change are STATELOOM_PORT and STATELOOM_DOC_DIR.

# ── the port your human opens ────────────────────────────────────────────────
# Any free port. 4598 is the convention, not a requirement — the container's
# own port is 8080 either way and nothing inside cares what it is published as.
STATELOOM_PORT=4598

# Loopback by default. 0.0.0.0 serves the whole network, including a tailnet;
# do that only behind TLS or on a network you trust.
STATELOOM_BIND=127.0.0.1

# ── the documents ────────────────────────────────────────────────────────────
# Host directory holding your .smdf.json files. It is mounted at /data and is
# the ONLY place the canvas and the MCP server can read or write.
STATELOOM_DOC_DIR=./looms

# The document that is open when the board first loads. It is created if it
# does not exist. Others in the same directory are reachable from the canvas's
# document switcher.
STATELOOM_DOC=statemachine.smdf.json

# Files are written from inside the container; running as your own uid is what
# keeps them editable on the host afterwards.  id -u  /  id -g
STATELOOM_UID=1000
STATELOOM_GID=1000

# ── the agent's door ─────────────────────────────────────────────────────────
# Bearer token for MCP over HTTP at http://<host>:<STATELOOM_PORT>/mcp.
# Left empty, the container mints one per start and prints it to its log —
# fine for a session, wrong for anything an MCP client is registered against,
# because a restart invalidates the registration. Generate a stable one:
#
#     openssl rand -hex 24
#
STATELOOM_MCP_TOKEN=

# ── the image ────────────────────────────────────────────────────────────────
# Pin a version rather than tracking :latest for anything long-lived.
STATELOOM_IMAGE=jgwill/stateloom:latest
