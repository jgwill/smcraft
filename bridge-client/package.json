{
  "name": "@miadi/stateloom-client",
  "version": "0.1.1",
  "description": "Framework-agnostic socket.io-client wrapper for the smcraft real-time design bridge (join/patch/full/presence + auto-resync)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jgwill/smcraft.git",
    "directory": "bridge-client"
  },
  "homepage": "https://github.com/jgwill/smcraft#readme",
  "bugs": {
    "url": "https://github.com/jgwill/smcraft/issues"
  },
  "author": "Guillaume Isabelle <jgi@jgwill.com>",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/tests/*.test.js",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "state-machine",
    "smdf",
    "bridge",
    "socket.io",
    "realtime",
    "client"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1",
    "@miadi/stateloom-protocol": "file:../bridge-protocol"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.7",
    "socket.io": "^4.8.1"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/tests/"
  ]
}
