{
  "name": "@miadi/stateloom-cli",
  "version": "0.1.3",
  "description": "smcx — the smcraft design-surface CLI: drive the live real-time bridge (durable-first mutate + emit, watch, presence) from the terminal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jgwill/smcraft.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/jgwill/smcraft#readme",
  "bugs": {
    "url": "https://github.com/jgwill/smcraft/issues"
  },
  "author": "Guillaume Isabelle <jgi@jgwill.com>",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "smcx": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js",
      "default": "./dist/render/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/tests/*.test.js",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "state-machine",
    "smdf",
    "bridge",
    "cli",
    "realtime"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "@miadi/stateloom": "file:../bridge",
    "@miadi/stateloom-client": "file:../bridge-client",
    "@miadi/stateloom-protocol": "file:../bridge-protocol"
  },
  "devDependencies": {
    "typescript": "^5.7",
    "@types/node": "^22"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/tests/"
  ]
}
