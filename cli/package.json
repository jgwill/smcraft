{
  "name": "@miadi/stateloom-cli",
  "version": "0.1.0",
  "description": "smcx — the smcraft design-surface CLI: drive the live real-time bridge (durable-first mutate + emit, watch, presence) from the terminal",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "smcx": "dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/tests/*.test.js",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "state-machine",
    "smdf",
    "bridge",
    "cli",
    "realtime"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "@miadi/stateloom": "file:../bridge",
    "@miadi/stateloom-client": "file:../bridge-client",
    "@miadi/stateloom-protocol": "file:../bridge-protocol"
  },
  "devDependencies": {
    "typescript": "^5.7",
    "@types/node": "^22"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ]
}
