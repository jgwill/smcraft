{
  "name": "@miadi/stateloom-mcp",
  "version": "0.2.1",
  "description": "MCP server for miadi-stateloom (formerly smcraft-mcp) — lets LLM agents design state machines through conversation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jgwill/smcraft.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/jgwill/smcraft#readme",
  "bugs": {
    "url": "https://github.com/jgwill/smcraft/issues"
  },
  "author": "Guillaume Isabelle <jgi@jgwill.com>",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "bin": {
    "stateloom-mcp": "dist/server.js",
    "smcraft-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --test dist/tests/*.test.js"
  },
  "keywords": [
    "state-machine",
    "smdf",
    "mcp",
    "model-context-protocol",
    "agent",
    "llm",
    "stateloom"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@miadi/stateloom-cli": "file:../cli",
    "@miadi/stateloom-client": "file:../bridge-client",
    "@miadi/stateloom-protocol": "file:../bridge-protocol",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.13",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/tests/"
  ]
}
